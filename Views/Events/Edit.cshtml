@model SchoolEventManagement.Models.Event

@{
    ViewData["Title"] = "Edit Event";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Edit Event</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedById" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold"></label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Venue" class="form-label fw-bold"></label>
                    <input asp-for="Venue" class="form-control" required />
                    <span asp-validation-for="Venue" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label fw-bold">Start Date &amp; Time</label>
                    <input asp-for="EventDate" class="form-control" type="datetime-local" required />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EndDateTime" class="form-label fw-bold">End Date &amp; Time</label>
                    <input asp-for="EndDateTime" class="form-control" type="datetime-local" required />
                    <span asp-validation-for="EndDateTime" class="text-danger"></span>
                </div>

                <hr />
                <h5 class="mb-3">Who can join this event?</h5>
                <div class="mb-3">
                    <label asp-for="TargetSchoolLevel" class="form-label fw-bold">Target school level</label>
                    <select asp-for="TargetSchoolLevel" class="form-select audience-level">
                        <option value="All">All school levels</option>
                        <option value="College">College only</option>
                        <option value="SHS">Senior High School (SHS) only</option>
                        <option value="JHS">Junior High School (JHS) only</option>
                    </select>
                    <span asp-validation-for="TargetSchoolLevel" class="text-danger"></span>
                </div>
                <div class="mb-3 audience-detail">
                    <label asp-for="TargetGradeLevel" class="form-label fw-bold">Target grade/year level (optional)</label>
                    <select asp-for="TargetGradeLevel" class="form-select audience-grade">
                        <option value="">All grades / year levels</option>
                        <option>Grade 7</option><option>Grade 8</option><option>Grade 9</option><option>Grade 10</option>
                        <option>Grade 11</option><option>Grade 12</option>
                        <option>1st Year</option><option>2nd Year</option><option>3rd Year</option><option>4th Year</option><option>5th Year</option>
                    </select>
                </div>
                <div class="mb-3 audience-detail audience-program-wrap">
                    <label asp-for="TargetProgram" class="form-label fw-bold">Target course / program / strand (optional)</label>
                    <input asp-for="TargetProgram" class="form-control" placeholder="e.g. BSIT, ICT, STEM; leave blank for all programs" />
                </div>
                <div class="mb-3 audience-detail">
                    <label asp-for="TargetSection" class="form-label fw-bold">Target section (optional)</label>
                    <input asp-for="TargetSection" class="form-control" placeholder="e.g. ICT 11-A; leave blank for all sections" />
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                    <button type="submit" class="btn btn-primary px-4 fw-bold">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const level = document.querySelector('.audience-level');
            const details = document.querySelectorAll('.audience-detail');
            const programWrap = document.querySelector('.audience-program-wrap');
            const programInput = document.getElementById('TargetProgram');
            function updateAudienceFields() {
                details.forEach(el => el.style.display = level.value === 'All' ? 'none' : '');
                if (programWrap) programWrap.style.display = (level.value === 'All' || level.value === 'JHS') ? 'none' : '';
                if (level.value === 'JHS' && programInput) programInput.value = '';
            }
            level.addEventListener('change', updateAudienceFields);
            updateAudienceFields();
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}