@model SchoolEventManagement.Models.Event

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Event</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Venue)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Venue)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.EventDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.EventDate)
        </dd>
    </dl>
        <dt class = "col-sm-2">Target School Level</dt>
        <dd class = "col-sm-10">@Model.TargetSchoolLevel</dd>
        <dt class = "col-sm-2">Target Grade / Year</dt>
        <dd class = "col-sm-10">@(Model.TargetGradeLevel ?? "All grades / year levels")</dd>
        <dt class = "col-sm-2">Target Program / Strand / Course</dt>
        <dd class = "col-sm-10">@(Model.TargetProgram ?? "All programs")</dd>
        <dt class = "col-sm-2">Target Section</dt>
        <dd class = "col-sm-10">@(Model.TargetSection ?? "All sections")</dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedById)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedById)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Registrations)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Registrations)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Evaluations)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Evaluations)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
