@model IEnumerable<SchoolEventManagement.Models.Teacher>

@{
    ViewData["Title"] = "Manage Teachers";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header">
    <div>
        <h3>Manage Teachers</h3>
        <div class="subtitle">Create teacher accounts and assign the courses they handle.</div>
    </div>
    <a asp-action="Create" class="btn btn-gold"><i class="bi bi-plus-lg me-1"></i>Add teacher</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Username</th>
                    <th>Courses</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center py-4 text-muted">No teacher accounts yet.</td></tr>
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="fw-bold">@t.FullName</td>
                        <td>@t.Username</td>
                        <td>
                            @foreach (var c in t.Courses.OrderBy(c => c.CourseName))
                            {
                                <span class="badge bg-primary me-1">@c.CourseName</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this teacher account?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
